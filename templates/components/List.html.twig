{% macro renderList(type, items) %}
{% if type == 'ordered' %}
<ol>
    {% for item in items %}
        <li>{{ item.content|raw }}</li>
    {% endfor %}
</ol>
{% else %}
<ul>
    {% for item in items %}
        <li>
        {%- if type == 'checklist' %}
           <input type="checkbox" {% if item.meta.checked|default(false) %}checked{% endif %}>
        {% endif -%}
        {{ item.content|raw }}
        {% if item.items %}
            {{ _self.renderList(type, item.items) }}
        {% endif %}
        </li>
    {% endfor %}
</ul>
{% endif %}
{% endmacro %}

{{ _self.renderList(type, items) }}
